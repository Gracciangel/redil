# Redil — variables de entorno para el build de producción
# Copiar como .env (local) o cargarlas en el panel del host de deploy.
# Todas las variables VITE_ se incrustan en el bundle: NUNCA pongas acá
# una service_role key, una Secret Key ni cualquier otro secreto.

# --- Supabase (obligatorio) -------------------------------------------------
# URL base del proyecto, sin /rest/v1.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Anon key (JWT con role=anon). Es pública: la seguridad la da RLS.
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# --- Unsplash (opcional) ----------------------------------------------------
# Access Key pública de cliente, usada solo para buscar imágenes.
# La Secret Key NO se usa y nunca va en el front.
# Límites: 50 req/h en demo, 1000 req/h con la app aprobada.
VITE_UNSPLASH_ACCESS_KEY=TU_ACCESS_KEY

# --- API propia (opcional) --------------------------------------------------
# Endpoint que recibe la cola offline de cambios. Si no se define,
# la sincronización queda desactivada y los cambios siguen en IndexedDB.
VITE_API_URL=https://TU-API/redil

# --- Aliases legacy ---------------------------------------------------------
# src/supabase/supabase.ts todavía los acepta como fallback para instalaciones
# viejas. NO hace falta definirlos en un deploy nuevo.
# VITE_AURL_SUPABASE=
# VITE_URL_ANON=
