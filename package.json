{
  "name": "redil",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA offline-first para la gestión de congregaciones evangélicas",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty",
    "deploy": "npm run build && firebase deploy --only hosting",
    "icons": "node scripts/generate-icons.mjs",
    "biblia:split": "node tools/split-bible.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/styled-engine-sc": "^9.5.0",
    "@supabase/supabase-js": "^2.119.0",
    "idb": "^8.0.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-is": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "styled-components": "^6.6.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  }
